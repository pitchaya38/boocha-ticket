{
  "name": "warehouse-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB --r2 PDF_BUCKET",
    "deploy": "wrangler pages deploy public",
    "db:migrate:local": "wrangler d1 execute warehouse-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute warehouse-db --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "jose": "^5.9.6"
  }
}
